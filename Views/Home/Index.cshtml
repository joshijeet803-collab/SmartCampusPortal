@model List<SmartCampusPortal.Models.ServiceRequest>
@{ViewData["Title"]="Smart Campus Portal";}
<div class="hero"><h1>Smart Campus Service Portal</h1><p>Manage campus services and student requests</p></div>
<div class="grid"><section class="panel"><h2>Submit Service Request</h2><form method="post" action="/Home/Create"><label>Request title</label><input name="title" required placeholder="e.g. Library access"><label>Category</label><select name="category"><option>IT Support</option><option>Library</option><option>Maintenance</option><option>Academic</option><option>Other</option></select><label>Details</label><textarea name="details" rows="4" placeholder="Describe your request"></textarea><button>Submit Request</button></form></section><section class="panel"><h2>Recent Requests</h2>@if(Model.Count==0){<p>No requests yet. Add your first request.</p>}else{<table><thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Date</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Title</td><td>@r.Category</td><td><span class="badge">@r.Status</span></td><td>@r.CreatedAt.ToString("dd MMM")</td></tr>}</tbody></table>}</section></div><section class="panel api"><h2>Students API</h2><p>API endpoint: <code>/api/students</code></p><a href="/api/students" target="_blank">View API JSON</a></section>